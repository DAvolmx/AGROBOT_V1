<?xml version='1.0' encoding='utf-8'?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1"><asset><unit name="meter" meter="1" /><up_axis>Z_UP</up_axis></asset><library_images><image id="photo-image"><init_from>soil_albedo.png</init_from></image></library_images><library_effects><effect id="photo-effect"><profile_COMMON><newparam sid="photo-surface"><surface type="2D"><init_from>photo-image</init_from></surface></newparam><newparam sid="photo-sampler"><sampler2D><source>photo-surface</source></sampler2D></newparam><technique sid="common"><phong><ambient><color>.6 .6 .6 1</color></ambient><diffuse><texture texture="photo-sampler" texcoord="UVSET0" /></diffuse><specular><color>0 0 0 1</color></specular><shininess><float>1</float></shininess></phong></technique></profile_COMMON></effect></library_effects><library_materials><material id="photo-material" name="photo-material"><instance_effect url="#photo-effect" /></material></library_materials><library_geometries><geometry id="surface" name="surface"><mesh><source id="positions"><float_array id="positions-array" count="12">-15.000000 -6.000000 0.000000 15.000000 -6.000000 0.000000 15.000000 6.000000 0.000000 -15.000000 6.000000 0.000000</float_array><technique_common><accessor source="#positions-array" count="4" stride="3"><param name="X" type="float" /><param name="Y" type="float" /><param name="Z" type="float" /></accessor></technique_common></source><source id="uv"><float_array id="uv-array" count="8">0.000000 0.000000 60.000000 0.000000 60.000000 24.000000 0.000000 24.000000</float_array><technique_common><accessor source="#uv-array" count="4" stride="2"><param name="S" type="float" /><param name="T" type="float" /></accessor></technique_common></source><vertices id="vertices"><input semantic="POSITION" source="#positions" /></vertices><triangles count="2" material="PHOTO"><input semantic="VERTEX" source="#vertices" offset="0" /><input semantic="TEXCOORD" source="#uv" offset="1" set="0" /><p>0 0 1 1 2 2 0 0 2 2 3 3</p></triangles></mesh></geometry></library_geometries><library_visual_scenes><visual_scene id="scene"><node id="mesh"><instance_geometry url="#surface"><bind_material><technique_common><instance_material symbol="PHOTO" target="#photo-material"><bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD" input_set="0" /></instance_material></technique_common></bind_material></instance_geometry></node></visual_scene></library_visual_scenes><scene><instance_visual_scene url="#scene" /></scene></COLLADA>