      <diffuse>0.420 0.271 0.129 1</diffuse>
     </material>
    </visual>
   </link>
  </model>
  <model name="agrobot" canonical_link="base_link">
   <pose>-2 0 0.31 0 0 0</pose>
   <link name="base_link">
    <inertial>
     <mass>8.8</mass>
     <inertia>
      <ixx>0.30</ixx>
      <iyy>0.38</iyy>
      <izz>0.42</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
     </inertia>
    </inertial>
    <collision name="chassis_collision">
     <geometry>
      <box>
       <size>0.50 0.33 0.16</size>
      </box>
     </geometry>
    </collision>
    <visual name="chassis_frame_visual">
     <pose>0 0 -0.075 0 0 0</pose>
     <geometry>
      <box>
       <size>0.50 0.33 0.035</size>
      </box>
     </geometry>
     <material>
      <ambient>0.800 0.043 0.024 1</ambient>
      <diffuse>0.800 0.043 0.024 1</diffuse>
     </material>
    </visual>
    <visual name="electronics_case_visual">
     <pose>-0.005 0 0.055 0 0 0</pose>
     <geometry>
      <box>
       <size>0.39 0.29 0.16</size>
      </box>
     </geometry>
     <material>
      <ambient>0.129 0.149 0.161 1</ambient>
      <diffuse>0.129 0.149 0.161 1</diffuse>
     </material>
    </visual>
