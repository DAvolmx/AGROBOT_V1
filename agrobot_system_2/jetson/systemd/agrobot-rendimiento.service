[Unit]
Description=AgroBot - Jetson al máximo rendimiento (MAXN SUPER + relojes fijos)
# Antes que el backend (YOLO) y ROS (SLAM/Nav2): que arranquen ya con la GPU
# y la CPU a frecuencia máxima, sin esperar a que el gobernador suba.
Before=agrobot-backend.service agrobot-ros.service
After=nvpmodel.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Modo 2 = MAXN_SUPER en /etc/nvpmodel/nvpmodel_p3767_0003_super.conf (el
# enlace /etc/nvpmodel.conf tiene que apuntar a ese archivo).
ExecStart=/usr/sbin/nvpmodel -m 2
# Fija CPU, GPU y memoria a su máximo y el ventilador al máximo. Sin esto el
# gobernador baja relojes entre inferencias y cada una arranca "en frío".
ExecStart=/usr/bin/jetson_clocks --fan

[Install]
WantedBy=multi-user.target
