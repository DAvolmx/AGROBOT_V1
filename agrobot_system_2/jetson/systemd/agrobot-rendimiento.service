[Unit]
Description=AgroBot - Jetson al máximo rendimiento (15 W + relojes fijos)
# Antes que el backend (YOLO) y ROS (SLAM/Nav2): que arranquen ya con la GPU
# y la CPU a frecuencia máxima, sin esperar a que el gobernador suba.
Before=agrobot-backend.service agrobot-ros.service
After=nvpmodel.service
Wants=nvpmodel.service

[Service]
Type=oneshot
RemainAfterExit=yes
# NO se llama a nvpmodel: cambiar de modo pide confirmar un reinicio por
# teclado y el servicio fallaba ("bad input"). El modo de 15 W es el que
# trae por defecto este perfil (nvpmodel_p3767_0003.conf) y se aplica solo al
# arrancar. MAXN SUPER no está disponible sin reflashear (2026-10-01).
# Fija CPU, GPU y memoria a su máximo y el ventilador al máximo. Sin esto el
# gobernador baja relojes entre inferencias y cada una arranca "en frío".
ExecStart=/usr/bin/jetson_clocks --fan

[Install]
WantedBy=multi-user.target
