     <pose>-0.005 0 0.139 0 0 0</pose>
     <geometry>
      <box>
       <size>0.395 0.295 0.012</size>
      </box>
     </geometry>
     <material>
      <ambient>0.420 0.459 0.471 0.52</ambient>
      <diffuse>0.420 0.459 0.471 0.52</diffuse>
     </material>
    </visual>
    <visual name="front_red_sensor_bumper">
     <pose>0.255 0 0.005 0 0 0</pose>
     <geometry>
      <box>
       <size>0.045 0.35 0.075</size>
      </box>
     </geometry>
     <material>
      <ambient>0.780 0.035 0.024 1</ambient>
      <diffuse>0.780 0.035 0.024 1</diffuse>
     </material>
    </visual>
    <visual name="rear_red_mount">
     <pose>-0.255 0 0.005 0 0 0</pose>
     <geometry>
      <box>
       <size>0.04 0.37 0.055</size>
      </box>
     </geometry>
     <material>
      <ambient>0.722 0.031 0.020 1</ambient>
      <diffuse>0.722 0.031 0.020 1</diffuse>
     </material>
    </visual>
    <sensor name="lidar_2d" type="gpu_lidar">
     <pose>0.05 0 0.28 0 0 0</pose>
     <always_on>true</always_on>
     <update_rate>3</update_rate>
     <topic>/agrobot/scan</topic>
     <lidar>
      <scan>
       <horizontal>
         <samples>120</samples>
        <resolution>1</resolution>
        <min_angle>-3.14159</min_angle>
        <max_angle>3.14159</max_angle>
       </horizontal>
      </scan>
      <range>
       <min>0.08</min>
       <max>8</max>
       <resolution>0.01</resolution>
      </range>
     </lidar>
    </sensor>
    <sensor name="camara_rgb" type="camera">
     <pose>0.235 0 0.18 0 0.25 0</pose>
     <always_on>true</always_on>
     <!-- 3 Hz equilibra respuesta visual y carga del renderizador EGL en Jetson. -->
     <update_rate>3</update_rate>
     <topic>/agrobot/camera/image_raw</topic>
     <camera>
      <horizontal_fov>1.22</horizontal_fov>
      <image>
        <width>240</width>
        <height>180</height>
       <format>R8G8B8</format>
      </image>
      <clip>
       <near>0.08</near>
       <far>8</far>
      </clip>
     </camera>
    </sensor>
    <sensor name="contacto_chasis" type="contact">
     <always_on>true</always_on>
     <update_rate>30</update_rate>
     <topic>/agrobot/contact</topic>
     <contact>
      <collision>chassis_collision</collision>
     </contact>
    </sensor>
    <visual name="front_yoke_visual">
     <pose>0.185 0 -0.115 0 0 0</pose>
     <geometry>
      <box>
       <size>0.08 0.18 0.035</size>
      </box>
     </geometry>
     <material>
      <ambient>0.678 0.024 0.020 1</ambient>
      <diffuse>0.678 0.024 0.020 1</diffuse>
     </material>
    </visual>
    <visual name="left_spring_body_visual">
     <pose>0.17 0.038 -0.015 0 0 0</pose>
     <geometry>
      <box>
       <size>0.035 0.035 0.14</size>
      </box>
     </geometry>
     <material>
      <ambient>0.698 0.035 0.024 1</ambient>
      <diffuse>0.698 0.035 0.024 1</diffuse>
     </material>
    </visual>
    <visual name="right_spring_body_visual">
     <pose>0.17 -0.038 -0.015 0 0 0</pose>
     <geometry>
      <box>
       <size>0.035 0.035 0.14</size>
      </box>
     </geometry>
     <material>
      <ambient>0.698 0.035 0.024 1</ambient>
      <diffuse>0.698 0.035 0.024 1</diffuse>
