      <diffuse>0.620 0.024 0.020 1</diffuse>
     </material>
    </visual>
   </link>
   <link name="front_axle">
    <!-- Pose explícita: las poses de joint son relativas al enlace hijo en SDF. -->
    <pose>0.185 0 -0.20 0 0 0</pose>
    <inertial>
     <mass>0.6</mass>
     <inertia>
      <ixx>0.018</ixx>
      <iyy>0.018</iyy>
      <izz>0.012</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
     </inertia>
    </inertial>
    <collision name="axle_collision">
     <geometry>
      <box>
       <size>0.08 0.134 0.045</size>
      </box>
     </geometry>
    </collision>
   </link>
   <joint name="front_pivot" type="revolute">
    <parent>base_link</parent>
    <child>front_axle</child>
    <pose>0 0 0 0 0 0</pose>
    <axis>
     <xyz>0 0 1</xyz>
     <limit>
      <lower>-0.349066</lower>
      <upper>0.349066</upper>
      <effort>20</effort>
      <velocity>1.2</velocity>
     </limit>
     <dynamics>
      <damping>0.35</damping>
      <friction>0.08</friction>
     </dynamics>
    </axis>
   </joint>
   <link name="front_left_wheel">
    <pose>0.185 0.067 -0.205 0 0 0</pose>
    <inertial>
     <mass>0.65</mass>
     <inertia>
      <ixx>0.003</ixx>
      <iyy>0.003</iyy>
      <izz>0.004</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
     </inertia>
    </inertial>
    <collision name="tire_collision">
     <pose>0 0 0 1.5708 0 0</pose>
     <geometry>
      <cylinder>
       <radius>0.11</radius>
       <length>0.052</length>
      </cylinder>
     </geometry>
     <surface>
      <friction>
       <ode>
        <mu>0.85</mu>
        <mu2>0.65</mu2>
        <slip1>0.03</slip1>
        <slip2>0.03</slip2>
       </ode>
      </friction>
     </surface>
    </collision>
    <visual name="tire_visual">
     <pose>0 0 0 1.5708 0 0</pose>
     <geometry>
      <cylinder>
       <radius>0.11</radius>
       <length>0.052</length>
      </cylinder>
     </geometry>
    </visual>
    <sensor name="contact_front_left" type="contact">
     <always_on>true</always_on>
     <update_rate>30</update_rate>
     <topic>/agrobot/contact/front_left</topic>
     <contact>
      <collision>tire_collision</collision>
     </contact>
    </sensor>
   </link>
   <joint name="front_left_wheel_joint" type="revolute">
    <parent>front_axle</parent>
    <child>front_left_wheel</child>
    <pose>0 0 0 0 0 0</pose>
    <axis>
     <!-- El cilindro se orienta a -Y con la rotación visual/collider +90° X;
          alinear el eje de junta evita que cmd_vel positivo impulse hacia atrás. -->
     <xyz>0 1 0</xyz>
     <limit>
      <effort>30</effort>
      <velocity>12</velocity>
     </limit>
     <dynamics>
      <damping>0.02</damping>
     </dynamics>
    </axis>
   </joint>
   <link name="front_right_wheel">
    <pose>0.185 -0.067 -0.205 0 0 0</pose>
    <inertial>
