<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
 <world name="huerta_ruda">
  <gravity>0 0 -9.81</gravity>
  <physics name="default" type="ignored">
   <max_step_size>0.001</max_step_size>
   <real_time_factor>0.65</real_time_factor>
   <real_time_update_rate>500</real_time_update_rate>
  </physics>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
  <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
   <render_engine>ogre2</render_engine>
  </plugin>
  <light name="sun" type="directional">
   <!-- Sombras dinámicas consumían el presupuesto de texturas EGL en la Jetson
        y dejaban el sensor RGB negro al avanzar. La forma de los surcos y las
        plantas conserva el contraste de navegación con luz difusa. -->
   <cast_shadows>false</cast_shadows>
   <pose>0 0 12 0.2 0.4 0</pose>
   <diffuse>0.86 0.81 0.70 1</diffuse>
   <direction>-0.35 0.1 -0.92</direction>
  </light>
  <model name="suelo">
   <static>true</static>
   <link name="ground">
    <collision name="ground_collision">
     <geometry>
      <plane>
       <normal>0 0 1</normal>
       <size>30 12</size>
      </plane>
     </geometry>
     <surface>
      <friction>
       <ode>
        <mu>0.85</mu>
        <mu2>0.65</mu2>
       </ode>
      </friction>
     </surface>
    </collision>
    <visual name="ground_visual">
     <geometry>
      <plane>
       <normal>0 0 1</normal>
       <size>30 12</size>
      </plane>
     </geometry>
     <material>
      <ambient>0.420 0.341 0.231 1</ambient>
      <diffuse>0.420 0.341 0.231 1</diffuse>
     </material>
    </visual>
   </link>
  </model>
  <model name="col_bajo_izquierda">
   <static>true</static>
   <pose>-0.95 0.38 0.06 0 0 0.15</pose>
   <link name="plant">
    <collision name="leaf">
     <geometry>
      <box>
       <size>0.34 0.20 0.08</size>
      </box>
     </geometry>
    </collision>
    <visual name="leaf_v">
     <geometry>
      <box>
       <size>0.34 0.20 0.08</size>
      </box>
     </geometry>
     <material>
      <ambient>0.200 0.459 0.102 1</ambient>
      <diffuse>0.200 0.459 0.102 1</diffuse>
     </material>
    </visual>
   </link>
  </model>
  <model name="lechuga_baja_derecha">
   <static>true</static>
   <pose>-0.80 -0.38 0.05 0 0 -0.2</pose>
   <link name="plant">
    <collision name="leaf">
